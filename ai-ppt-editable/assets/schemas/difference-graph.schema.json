{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joeshu.github.io/ai-ppt-plus/schemas/difference-graph.schema.json",
  "title": "Astra Visual QA Difference Graph",
  "type": "object",
  "required": ["version", "source_id", "rendered_id", "findings"],
  "properties": {
    "version": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "rendered_id": {"type": "string", "minLength": 1},
    "aggregate": {"type": "object"},
    "metadata": {"type": "object"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "object_id", "domain", "severity", "message"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "object_id": {"type": "string", "minLength": 1},
          "domain": {"enum": ["geometry", "typography", "asset", "semantic"]},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "message": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "metrics": {"type": "object"},
          "proposed_patch": {"type": "object"},
          "evidence": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
