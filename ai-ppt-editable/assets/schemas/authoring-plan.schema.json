{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-ppt-plus/authoring-plan.schema.json",
  "title": "AI PPT AuthoringPlan",
  "type": "object",
  "required": ["schema", "source", "canvas", "objects"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/authoring-plan/v1"},
    "source": {
      "type": "object",
      "required": ["sha256", "width_px", "height_px"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "units"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "units": {"enum": ["normalized", "px", "pt", "in"]}
      },
      "additionalProperties": true
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_id", "page", "semantic_role", "implementation_type", "bbox", "z_role"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "semantic_role": {"type": "string", "minLength": 1},
          "implementation_type": {
            "enum": ["native_text", "native_shape", "native_table", "native_chart", "connector", "freeform", "imagegen_asset"]
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "parent_id": {"type": ["string", "null"]},
          "component_family": {"type": ["string", "null"]},
          "z_role": {"type": "string", "minLength": 1},
          "anchors": {"type": "array", "items": {"type": "object"}},
          "protected_neighbors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "typography_contract": {"type": "object"},
          "asset_contract": {"type": "object"},
          "geometry_contract": {"type": "object"},
          "table_contract": {"type": "object"},
          "chart_contract": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
