{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "skill", "owns", "forbids", "bindings"],
  "properties": {
    "schema": {"const": "ai-ppt-editable/skill-routing/v1"},
    "skill": {"const": "ai-ppt-editable"},
    "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bindings": {
      "type": "object",
      "required": ["authoring", "qa_inspection", "strict_authoring"],
      "properties": {
        "authoring": {
          "type": "object",
            "required": ["kind", "backend", "language", "module_format", "builder", "runtime_entrypoint", "contract", "required_for"],
          "properties": {
            "kind": {"const": "adapter"},
            "backend": {"const": "@oai/artifact-tool"},
            "language": {"const": "javascript"},
            "module_format": {"const": "ESM"},
            "builder": {"type": "string", "minLength": 1},
            "runtime_entrypoint": {"type": "string", "minLength": 1},
            "contract": {"const": "ai-ppt-plus/authoring-contract/v1"},
            "required_for": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "qa_inspection": {
          "type": "object",
          "required": ["kind", "backend", "optional_python_pptx", "purpose"],
          "properties": {
            "kind": {"const": "read-only-adapter"},
            "backend": {"const": "OOXML"},
            "optional_python_pptx": {"type": "boolean"},
            "purpose": {"const": "inspection-and-regression-tests-only"}
          }
        },
        "strict_authoring": {
          "type": "object",
          "required": ["kind", "backend", "language", "module_format", "runtime_entrypoint", "contract", "required_for"],
          "properties": {
            "kind": {"const": "adapter"},
            "backend": {"const": "@oai/artifact-tool"},
            "language": {"const": "javascript"},
            "module_format": {"const": "ESM"},
            "runtime_entrypoint": {"type": "string", "minLength": 1},
            "contract": {"const": "ai-ppt-plus/authoring-contract/v1"},
            "required_for": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
