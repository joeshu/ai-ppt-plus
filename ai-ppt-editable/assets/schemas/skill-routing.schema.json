{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "skill", "owns", "forbids", "bindings"],
  "properties": {
    "schema": {"const": "ai-ppt-editable/skill-routing/v1"},
    "skill": {"const": "ai-ppt-editable"},
    "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bindings": {
      "type": "object",
      "required": ["authoring"],
      "properties": {
        "authoring": {
          "type": "object",
          "required": ["kind", "backend", "entrypoint", "font_postprocessor"],
          "properties": {
            "kind": {"const": "adapter"},
            "backend": {"const": "python-pptx"},
            "entrypoint": {"type": "string", "minLength": 1},
            "font_postprocessor": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
