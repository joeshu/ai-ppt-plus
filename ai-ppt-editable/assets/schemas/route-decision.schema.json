{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "project_id", "route", "status", "visual_authority", "formal_content_authority", "requires_image_generation", "primary_engine", "fallback_policy", "fallback_used", "fallback_events", "editable_object_policy"],
  "properties": {
    "schema": {"type": "string", "enum": ["ai-ppt-plus/route-decision/v1", "ai-ppt-plus/route-decision/v2"]},
    "project_id": {"type": "string", "minLength": 1},
    "route": {"type": "string", "enum": ["visual-creation", "reference-reconstruction", "native-authoring"]},
    "status": {"type": "string", "enum": ["decided", "needs_user", "blocked"]},
    "visual_authority": {"type": "string", "enum": ["generated_visual_intermediate", "approved_reference_image", "approved_design_system"]},
    "formal_content_authority": {"type": "string", "enum": ["approved_outline", "user_transcription", "transcription_pending_confirmation"]},
    "requires_image_generation": {"type": "boolean"},
    "primary_engine": {"type": "string", "enum": ["ai-ppt-editable", "ai-ppt-visual-gen"]},
    "fallback_policy": {"type": "string", "enum": ["none", "scoped-visual-only"]},
    "fallback_used": {"type": "boolean"},
    "fallback_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engine", "scope", "role", "region", "contains_formal_content", "whole_page", "reason", "asset_record", "user_decision"],
        "properties": {
          "engine": {"const": "GordenImage2PPTX"},
          "scope": {"const": "region"},
          "role": {"type": "string"},
          "region": {
            "oneOf": [
              {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
              {"type": "object", "required": ["x", "y", "w", "h"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number"}, "h": {"type": "number"}}}
            ]
          },
          "contains_formal_content": {"const": false},
          "whole_page": {"const": false},
          "full_page": {"type": "boolean"},
          "object_type": {"type": "string"},
          "reason": {"type": "string", "minLength": 1},
          "asset_record": {"type": "object", "required": ["manifest", "asset_id"], "properties": {"manifest": {"type": "string", "minLength": 1}, "asset_id": {"type": "string", "minLength": 1}}},
          "user_decision": {"type": "object", "required": ["status", "by", "at"], "properties": {"status": {"const": "approved"}, "by": {"type": "string", "minLength": 1}, "at": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "editable_object_policy": {"type": "string", "enum": ["native-semantic-objects", "image-slide"]},
    "outline_contract": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
      "additionalProperties": false
    },
    "visual_generation_mode": {"type": "string", "enum": ["image-slide", "layout-reference"]},
    "visual_generation_plan": {"type": ["string", "null"]},
    "visual_generation_manifest": {"type": ["string", "null"]},
    "visual_intermediate_manifest": {"type": ["string", "null"]},
    "native_content_manifest": {"type": ["string", "null"]},
    "reference_roster": {"type": "array"},
    "reason": {"type": "string"},
    "confirmed_by": {"type": "string"},
    "confirmed_at": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"route": {"const": "native-authoring"}}},
      "then": {
        "required": ["native_content_manifest"],
        "properties": {
          "schema": {"const": "ai-ppt-plus/route-decision/v2"},
          "visual_authority": {"const": "approved_design_system"},
          "requires_image_generation": {"const": false},
          "primary_engine": {"const": "ai-ppt-editable"},
          "fallback_policy": {"const": "none"},
          "editable_object_policy": {"const": "native-semantic-objects"}
        }
      }
    },
    {
      "if": {"properties": {"route": {"const": "visual-creation"}}},
      "then": {
        "properties": {
          "visual_authority": {"const": "generated_visual_intermediate"},
          "requires_image_generation": {"const": true},
          "primary_engine": {"const": "ai-ppt-visual-gen"},
          "fallback_policy": {"const": "none"},
          "editable_object_policy": {"const": "image-slide"}
        }
      }
    },
    {
      "if": {"properties": {"route": {"const": "reference-reconstruction"}}},
      "then": {
        "properties": {
          "visual_authority": {"const": "approved_reference_image"},
          "requires_image_generation": {"const": false},
          "primary_engine": {"const": "ai-ppt-editable"},
          "fallback_policy": {"const": "scoped-visual-only"},
          "editable_object_policy": {"const": "native-semantic-objects"}
        }
      }
    }
  ],
  "additionalProperties": true
}
