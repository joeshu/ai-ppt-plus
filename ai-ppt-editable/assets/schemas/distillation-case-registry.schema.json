{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "version", "cases"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/distillation-case-registry/v1"},
    "version": {"type": "integer", "const": 1},
    "updated_at": {"type": "string"},
    "cases": {"type": "array", "items": {"type": "object", "required": ["case_id", "source_references", "candidates"], "properties": {"case_id": {"type": "string"}, "created_at": {"type": "string"}, "source_references": {"type": "array", "minItems": 1}, "candidates": {"type": "array", "minItems": 1}}}}
  }
}
