{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joeshu.github.io/ai-ppt-plus/asset-render-coordinate.schema.json",
  "title": "Asset-to-Render Coordinate Record",
  "type": "object",
  "required": ["schema", "page", "object_id", "asset", "slot", "render"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/asset-render-coordinate/v1"},
    "page": {"type": "integer", "minimum": 1},
    "object_id": {"type": "string", "minLength": 1},
    "asset": {
      "type": "object",
      "required": ["canvas_px", "alpha_bbox_px", "alpha_centroid_px"],
      "properties": {
        "canvas_px": {"type": "array", "prefixItems": [{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0}], "minItems":2, "maxItems":2},
        "alpha_bbox_px": {"type":"array", "items":{"type":"number"}, "minItems":4, "maxItems":4},
        "alpha_centroid_px": {"type":"array", "items":{"type":"number"}, "minItems":2, "maxItems":2},
        "safe_padding_px": {"type":"array", "items":{"type":"number"}, "minItems":4, "maxItems":4}
      }
    },
    "slot": {
      "type":"object",
      "required":["bbox_norm"],
      "properties":{"bbox_norm":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4}}
    },
    "render": {
      "type":"object",
      "required":["canvas_px", "observed_visible_bbox_px"],
      "properties": {
        "canvas_px":{"type":"array","prefixItems":[{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0}],"minItems":2,"maxItems":2},
        "observed_visible_bbox_px":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4}
      }
    }
  },
  "additionalProperties": true
}
