{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "example_id", "task", "split", "source", "target", "supervision", "provenance"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/distillation-training-example/v1"},
    "example_id": {"type": "string"},
    "task": {"type": "string"},
    "split": {"enum": ["train", "validation", "test"]},
    "source": {"type": "array", "minItems": 1},
    "target": {"type": "object", "required": ["deck"]},
    "supervision": {"type": "object", "required": ["score", "reports", "metrics"]},
    "provenance": {"type": "object", "required": ["case_id", "candidate_id", "human_approval", "source_sha256"]}
  }
}
