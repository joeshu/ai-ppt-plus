{
  "schema": "ai-ppt-plus/imagegen-assets/v1",
  "request_id": "<current-reference-rerun-request-id>",
  "provenance_policy": "imagegen_or_source_reuse",
  "asset_generation_policy": "transparent_first_v1",
  "run_root": "/workspace/.../unique-run",
  "generation_accounting": {
    "billable_generation_calls": 3,
    "billable_transparent_edit_calls": 0,
    "local_derivative_count": 2,
    "qa_preview_count": 1,
    "full_sheet_retries": 0,
    "single_asset_retries": 0
  },
  "assets": [
    {
      "id": "background",
      "request_id": "<current-reference-rerun-request-id>",
      "provenance_mode": "imagegen",
      "layer": "background",
      "generated_source": "/imagegen/generated/background.png",
      "copied_to": "editable/01/background.png",
      "actual_sha256": "<sha256-of-final-background>",
      "prompt_file": "editable/01/prompts/background.txt",
      "backend": "codex-imagegen",
      "background_mode": "opaque",
      "fallback_level": "opaque",
      "canonical_asset": true,
      "qa_preview_only": false,
      "cache_key": "<64-char-background-cache-key>"
    },
    {
      "id": "frame_raw",
      "request_id": "<current-reference-rerun-request-id>",
      "provenance_mode": "imagegen",
      "layer": "frame_raw",
      "generated_source": "/imagegen/generated/frame.png",
      "copied_to": "editable/01/frame_raw.png",
      "actual_sha256": "<sha256-of-final-frame>",
      "prompt_file": "editable/01/prompts/frame.txt",
      "backend": "codex-imagegen",
      "background_mode": "transparent",
      "fallback_level": "direct-alpha",
      "canonical_asset": true,
      "qa_preview_only": false,
      "cache_key": "<64-char-frame-cache-key>"
    },
    {
      "id": "icons_raw_1",
      "request_id": "<current-reference-rerun-request-id>",
      "provenance_mode": "imagegen",
      "layer": "icons_raw_1",
      "generated_source": "/imagegen/generated/icons.png",
      "copied_to": "editable/01/icons_raw_1.png",
      "actual_sha256": "<sha256-of-final-icons>",
      "prompt_file": "editable/01/prompts/icons.txt",
      "backend": "codex-imagegen",
      "background_mode": "transparent",
      "fallback_level": "direct-alpha",
      "canonical_asset": true,
      "qa_preview_only": false,
      "cache_key": "<64-char-icons-cache-key>"
    }
  ]
}
