{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joeshu.github.io/ai-ppt-plus/asset-identity-contract.schema.json",
  "title": "ImageGen Asset Color/Identity Contract",
  "type": "object",
  "required": ["schema", "semantic_identity", "contour_traits", "color_roles", "alpha", "provenance"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/asset-identity-contract/v1"},
    "semantic_identity": {
      "type": "object",
      "required": ["subject", "must_preserve", "forbidden_substitutions"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_substitutions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "contour_traits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "color_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "hex"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "tolerance": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "alpha": {
      "type": "object",
      "required": ["required", "transparent_edges", "safe_padding_ratio"],
      "properties": {
        "required": {"const": true},
        "transparent_edges": {"const": true},
        "safe_padding_ratio": {"type": "number", "minimum": 0, "maximum": 0.35}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["generation_required", "source_crop_final_fallback"],
      "properties": {
        "generation_required": {"const": true},
        "source_crop_final_fallback": {"const": false},
        "reference_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
