{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "orchestrator", "skills", "fallback_policy", "shared_contracts", "bindings"],
  "properties": {
    "schema": {"type": "string", "enum": ["ai-ppt-plus/skill-routing/v1"]},
    "orchestrator": {"type": "string", "enum": ["ai-ppt-plus"]},
    "skills": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["name", "role", "owns", "forbids"], "properties": {"name": {"type": "string", "enum": ["ai-ppt-plus", "ai-ppt-visual-gen", "ai-ppt-editable"]}, "role": {"type": "string", "enum": ["orchestrator", "visual-worker", "editable-worker"]}, "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "forbids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}},
    "fallback_policy": {
      "type": "object",
      "required": ["schema", "primary_engine", "fallback_engine", "fallback_scope", "allow_full_page", "requires_explicit_reason", "requires_asset_record", "requires_user_decision_on_generation_failure", "forbidden_roles"],
      "properties": {
        "schema": {"const": "ai-ppt-plus/fallback-policy/v1"},
        "primary_engine": {"const": "ai-ppt-editable"},
        "fallback_engine": {"const": "GordenImage2PPTX"},
        "fallback_scope": {"const": "region-only"},
        "allow_full_page": {"const": false},
        "requires_explicit_reason": {"const": true},
        "requires_asset_record": {"const": true},
        "requires_user_decision_on_generation_failure": {"const": true},
        "forbidden_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "shared_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bindings": {
      "type": "object",
      "required": ["orchestrator", "reconstruction", "visual_generation", "authoring"],
      "properties": {
        "orchestrator": {"type": "object", "required": ["skill", "entrypoint"]},
        "reconstruction": {"type": "object", "required": ["skill", "invocation", "skill_entrypoint", "runtime_entrypoint", "required_for"]},
        "visual_generation": {"type": "object", "required": ["skill", "invocation", "skill_entrypoint", "runtime_entrypoint", "required_for", "tool_resolution", "preferred_tool", "backend_policy", "source_retention", "prompt_contract"]},
        "authoring": {"type": "object", "required": ["kind", "backend", "entrypoint", "font_postprocessor"]}
      }
    }
  }
}
