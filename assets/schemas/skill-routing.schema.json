{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "orchestrator", "skills", "shared_contracts"],
  "properties": {
    "schema": {"type": "string", "enum": ["ai-ppt-plus/skill-routing/v1"]},
    "orchestrator": {"type": "string", "enum": ["ai-ppt-plus"]},
    "skills": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["name", "role", "owns", "forbids"], "properties": {"name": {"type": "string"}, "role": {"type": "string"}, "owns": {"type": "array"}, "forbids": {"type": "array"}}}},
    "shared_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
