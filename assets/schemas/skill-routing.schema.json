{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "orchestrator", "skills", "shared_contracts", "bindings"],
  "properties": {
    "schema": {"type": "string", "enum": ["ai-ppt-plus/skill-routing/v1"]},
    "orchestrator": {"type": "string", "enum": ["ai-ppt-plus"]},
    "skills": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["name", "role", "owns", "forbids"], "properties": {"name": {"type": "string"}, "role": {"type": "string"}, "owns": {"type": "array"}, "forbids": {"type": "array"}}}},
    "shared_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bindings": {
      "type": "object",
      "required": ["orchestrator", "reconstruction", "visual_generation", "authoring"],
      "properties": {
        "orchestrator": {"type": "object", "required": ["skill", "entrypoint"]},
        "reconstruction": {"type": "object", "required": ["skill", "invocation", "required_for"]},
        "visual_generation": {"type": "object", "required": ["skill", "invocation", "required_for", "tool_resolution", "preferred_tool", "backend_policy", "source_retention", "prompt_contract"]},
        "authoring": {"type": "object", "required": ["backend", "entrypoint", "font_postprocessor"]}
      }
    }
  }
}
