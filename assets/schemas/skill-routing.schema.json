{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "orchestrator", "skills", "failure_policy", "shared_contracts", "bindings"],
  "properties": {
    "schema": {"type": "string", "enum": ["ai-ppt-plus/skill-routing/v1"]},
    "orchestrator": {"type": "string", "enum": ["ai-ppt-plus"]},
    "skills": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["name", "role", "owns", "forbids"], "properties": {"name": {"type": "string", "enum": ["ai-ppt-plus", "ai-ppt-visual-gen", "ai-ppt-editable"]}, "role": {"type": "string", "enum": ["orchestrator", "visual-worker", "editable-worker"]}, "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "forbids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}},
    "failure_policy": {
      "type": "object",
      "required": ["schema", "authoring_backend", "image_asset_backend", "on_authoring_unavailable", "on_imagegen_unavailable", "automatic_backend_substitution", "source_crop_fallback", "external_skill_fallback"],
      "properties": {
        "schema": {"const": "ai-ppt-plus/failure-policy/v1"},
        "authoring_backend": {"const": "@oai/artifact-tool"},
        "image_asset_backend": {"const": "imagegen"},
        "on_authoring_unavailable": {"const": "blocked"},
        "on_imagegen_unavailable": {"const": "blocked"},
        "automatic_backend_substitution": {"const": false},
        "source_crop_fallback": {"const": false},
        "external_skill_fallback": {"const": false}
      },
      "additionalProperties": false
    },
    "shared_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bindings": {
      "type": "object",
      "required": ["orchestrator", "reconstruction", "visual_generation", "authoring", "qa_inspection", "strict_authoring"],
      "properties": {
        "orchestrator": {"type": "object", "required": ["skill", "entrypoint"]},
        "reconstruction": {"type": "object", "required": ["skill", "invocation", "skill_entrypoint", "runtime_entrypoint", "required_for"]},
        "visual_generation": {"type": "object", "required": ["skill", "invocation", "skill_entrypoint", "runtime_entrypoint", "required_for", "tool_resolution", "preferred_tool", "backend_policy", "source_retention", "prompt_contract"]},
        "authoring": {"type": "object", "required": ["kind", "backend", "language", "module_format", "builder", "runtime_entrypoint", "contract", "required_for"]},
        "qa_inspection": {"type": "object", "required": ["kind", "backend", "optional_python_pptx", "purpose"]},
        "strict_authoring": {"type": "object", "required": ["kind", "backend", "language", "module_format", "runtime_entrypoint", "contract", "required_for"]}
      }
    }
  }
}
