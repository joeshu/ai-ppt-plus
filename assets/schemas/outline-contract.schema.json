{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "project_id", "outline_id", "outline_revision", "outline_path", "outline_sha256", "slide_count", "approval", "rows", "created_at"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/outline-contract/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "outline_id": {"type": "string", "minLength": 1},
    "outline_revision": {"type": "string", "minLength": 1},
    "outline_path": {"type": "string", "minLength": 1},
    "outline_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "slide_count": {"type": "integer", "minimum": 1},
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["draft", "needs_user", "approved", "superseded", "blocked"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["slide_no", "row_sha256", "status"],
      "properties": {
        "slide_no": {"type": "integer", "minimum": 1},
        "row_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "status": {"type": "string"},
        "title": {"type": "string"},
        "core_message": {"type": "string"},
        "body_content": {"type": "string"}
      },
      "additionalProperties": true
    }},
    "source_references": {"type": "array", "items": {"type": "object"}},
    "supersedes": {"type": ["string", "null"]},
    "change_log": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
