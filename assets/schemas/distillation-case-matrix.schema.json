{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joeshu/ai-ppt-plus/schemas/distillation-case-matrix.schema.json",
  "title": "AI PPT Plus distillation case matrix",
  "type": "object",
  "required": ["schema", "version", "policy", "cases"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/distillation-case-matrix/v1"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "policy": {
      "type": "object",
      "required": [
        "targeted_selection",
        "premerge_selection",
        "nightly_selection",
        "required_evidence",
        "static_sentinel_never_promotes",
        "replay_ready_required_for_affected_category",
        "coverage_debt_is_reported"
      ],
      "properties": {
        "targeted_selection": {"type": "string"},
        "premerge_selection": {"type": "string"},
        "nightly_selection": {"type": "string"},
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "static_sentinel_never_promotes": {"type": "boolean"},
        "replay_ready_required_for_affected_category": {"type": "boolean"},
        "coverage_debt_is_reported": {"type": "boolean"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "title",
          "priority",
          "responsibility",
          "mode",
          "status",
          "replay_required",
          "contract_tests",
          "required_checks"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "responsibility": {
            "enum": [
              "routing",
              "native-structure",
              "text-visual",
              "package-contract",
              "cache-integrity"
            ]
          },
          "mode": {"enum": ["contract", "replay", "both"]},
          "status": {"enum": ["ready", "planned", "sentinel"]},
          "replay_required": {"type": "boolean"},
          "replay": {
            "type": "object",
            "properties": {
              "spec": {"type": "string"},
              "source_deck": {"type": "string"},
              "process_image": {"type": "string"},
              "candidate_deck": {"type": "string"},
              "reference_image": {"type": "string"},
              "static_sentinel": {"type": "boolean"}
            }
          },
          "contract_tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_checks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
