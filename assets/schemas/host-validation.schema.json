{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "valid", "status", "strict", "host", "deck", "deck_sha256", "checked_slides", "checks", "issues", "human_visual_review_required"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/host-validation/v1"},
    "valid": {"type": "boolean"},
    "status": {"enum": ["passed", "blocked"]},
    "strict": {"type": "boolean"},
    "host": {"type": "object"},
    "deck": {"type": "string"},
    "deck_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checked_slides": {"type": "array", "minItems": 1},
    "checks": {"type": "object"},
    "issues": {"type": "array"},
    "human_visual_review_required": {"const": true}
  }
}
