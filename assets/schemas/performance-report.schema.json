{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "status", "run_id", "execution", "steps_by_duration", "failed_steps"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/performance-report/v1"},
    "status": {"enum": ["passed", "blocked"]},
    "run_id": {"type": ["string", "null"]},
    "execution": {
      "type": "object",
      "required": ["execution_profile", "time_to_first_visual_render_ms", "candidate_build_count", "full_render_count", "imagegen_call_count", "text_fit_total_ms", "render_attempt_count", "visual_regression_status", "cache_hits", "cache_misses", "cache_hit_rate", "wall_duration_ms", "task_duration_ms_sum", "critical_path_ms", "retry_count", "repair_rounds", "page_cache"],
      "properties": {
        "execution_profile": {"enum": ["fast", "strict", "ci"]},
        "time_to_first_visual_render_ms": {"type": ["number", "null"], "minimum": 0},
        "candidate_build_count": {"type": "integer", "minimum": 0},
        "full_render_count": {"type": "integer", "minimum": 0},
        "imagegen_call_count": {"type": "integer", "minimum": 0},
        "text_fit_total_ms": {"type": "number", "minimum": 0},
        "render_attempt_count": {"type": "integer", "minimum": 0},
        "authoritative_visual_renderer": {"type": ["string", "null"]},
        "visual_regression_status": {"enum": ["not_evaluated", "passed", "regressed", "improved"]},
        "cache_hits": {"type": "integer", "minimum": 0},
        "cache_misses": {"type": "integer", "minimum": 0},
        "cache_hit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "wall_duration_ms": {"type": "number", "minimum": 0},
        "task_duration_ms_sum": {"type": "number", "minimum": 0},
        "critical_path_ms": {"type": "number", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "repair_rounds": {"type": "integer", "minimum": 0},
        "page_cache": {"type": "object"}
      }
    },
    "steps_by_duration": {"type": "array"},
    "failed_steps": {"type": "array"}
  }
}
