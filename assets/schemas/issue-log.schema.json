{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-ppt-plus/issue-log/v1",
  "type": "object",
  "required": ["schema", "project_id", "revision", "issues"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/issue-log/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "owner", "trigger", "root_cause", "fix", "regression_test", "affected_stages"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["info", "minor", "major", "critical", "blocker"]},
          "status": {"enum": ["open", "in-progress", "revision-required", "closed", "fixed", "accepted"]},
          "owner": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "root_cause": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1},
          "regression_test": {"type": "string", "minLength": 1},
          "affected_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "resolved_revision": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
