{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "report_type",
    "valid",
    "status",
    "technical_valid",
    "technical_status",
    "validation_scope",
    "full_deck_validation_required",
    "release_eligible",
    "release_status",
    "human_review_required",
    "human_review_status",
    "deck_sha256",
    "report_index_sha256",
    "checks",
    "issues",
    "source_references"
  ],
  "properties": {
    "schema": {"type": "string", "enum": ["ai-ppt-plus/report-envelope/v1"]},
    "report_type": {"type": "string", "enum": ["report-bundle-validation"]},
    "project_id": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "stage": {"type": ["string", "null"]},
    "valid": {"type": "boolean"},
    "status": {"type": "string", "enum": ["passed", "failed"]},
    "technical_valid": {"type": "boolean"},
    "technical_status": {"type": "string", "enum": ["passed", "failed"]},
    "validation_scope": {"type": ["string", "null"], "enum": ["full", "incremental", null]},
    "full_deck_validation_required": {"type": "boolean"},
    "release_eligible": {"type": "boolean"},
    "release_status": {"type": "string"},
    "human_review_required": {"type": "boolean"},
    "human_review_status": {"type": "string"},
    "deck_path": {"type": ["string", "null"]},
    "deck_sha256": {"type": ["string", "null"]},
    "report_index_path": {"type": "string"},
    "report_index_sha256": {"type": ["string", "null"]},
    "pipeline_result_path": {"type": "string"},
    "project_report_path": {"type": "string"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "issues": {"type": "array", "items": {"type": "object"}},
    "source_references": {"type": "array", "items": {"type": "object"}}
  }
}
