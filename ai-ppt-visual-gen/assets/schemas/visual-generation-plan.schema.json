{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "project_id", "route", "mode", "outline_revision", "design_system_revision", "page_count", "canvas", "density_profile", "style_lock", "generation_context", "retry_policy", "slides"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/visual-generation-plan/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "route": {"const": "visual-creation"},
    "mode": {"enum": ["image-slide", "layout-reference"]},
    "outline_revision": {"type": "string", "minLength": 1},
    "design_system_revision": {"type": "string", "minLength": 1},
    "narrative_gate": {
      "type": "object",
      "properties": {
        "schema": {"const": "ai-ppt-plus/narrative-gate/v1"},
        "workflow": {"const": "ppt-thought-table-first"},
        "outline_table": {"type": "string", "minLength": 1},
        "outline_table_sha256": {"type": "string"},
        "revision": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "needs_user", "approved", "blocked", "superseded"]},
        "approval_required": {"type": "boolean"},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"},
        "feedback_round": {"type": "integer", "minimum": 0},
        "owner_notes_preserved": {"type": "boolean"},
        "formal_text_authority": {"type": "string"},
        "change_log": {"type": "string"}
      }
    },
    "page_count": {"type": "integer", "minimum": 1},
    "canvas": {"type": "object", "required": ["ratio"], "properties": {"ratio": {"enum": ["16:9", "3:2"]}, "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1}}},
    "canvas_policy": {
      "type": "object",
      "properties": {
        "require_exact_dimensions": {"type": "boolean"},
        "minimum_width_px": {"type": "integer", "minimum": 1},
        "minimum_height_px": {"type": "integer", "minimum": 1},
        "on_mismatch": {"enum": ["block", "warn"]}
      }
    },
    "density_profile": {"enum": ["dense", "balanced", "minimal"]},
    "style_lock": {"type": "object", "required": ["palette", "font_style", "surface", "icon_style", "avoid_items"], "properties": {"palette": {"type": "array", "minItems": 3}, "font_style": {"type": "string"}, "surface": {"type": "string"}, "icon_style": {"type": "string"}, "grid": {"type": "string"}, "shared_chrome": {"type": "string"}, "material_language": {"type": "string"}, "avoid_items": {"type": "array"}}},
    "quality_target": {
      "type": "object",
      "properties": {
        "tier": {"type": "string"},
        "visual_language": {"type": "string"},
        "must_have": {"type": "array", "items": {"type": "string"}},
        "avoid_items": {"type": "array", "items": {"type": "string"}},
        "readability": {
          "type": "object",
          "properties": {
            "target_viewing": {"type": "string"},
            "min_title_px": {"type": "number", "minimum": 1},
            "min_body_px": {"type": "number", "minimum": 1},
            "min_annotation_px": {"type": "number", "minimum": 1},
            "max_visible_copy_items": {"type": "integer", "minimum": 1}
          }
        },
        "commercial_policy": {"type": "object"}
      }
    },
    "generation_session": {
      "type": "object",
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "continuity_policy": {"enum": ["single-model-single-context", "single-model-shared-anchor", "best-effort"]},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 6},
        "style_anchor": {"type": "string", "minLength": 1},
        "shared_preamble": {"type": "string", "minLength": 1}
      }
    },
    "generation_context": {"type": "object", "required": ["audience", "language", "presentation_context"], "properties": {"audience": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 1}, "presentation_context": {"type": "string", "minLength": 1}}},
    "retry_policy": {"type": "object", "required": ["max_attempts_per_slide", "scope", "triggers"], "properties": {"max_attempts_per_slide": {"type": "integer", "minimum": 1, "maximum": 3}, "scope": {"enum": ["single-slide"]}, "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "generation_contract": {"type": "object", "required": ["skill", "tool_resolution", "preferred_tool", "backend_policy", "source_retention", "no_code_overlay"], "properties": {"skill": {"type": "string"}, "tool_resolution": {"type": "string"}, "preferred_tool": {"type": "string"}, "backend_policy": {"type": "string"}, "source_retention": {"type": "string"}, "no_code_overlay": {"type": "boolean"}}},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_no", "page_type", "title", "core_logic", "visual_framework", "visual_generation_prompt", "content_model"],
        "properties": {
          "slide_no": {"type": "integer", "minimum": 1},
          "outline_row_ref": {"type": "string"},
          "page_type": {"type": "string"},
          "title": {"type": "string"},
          "core_logic": {"type": "string"},
          "visual_framework": {"type": "string"},
          "visual_generation_prompt": {"type": "string"},
          "closure_treatment": {"type": "string", "minLength": 1},
          "detailed_content_paragraphs": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
          "layout_blueprint": {
            "type": "object",
            "required": ["focal_point", "reading_path", "zones", "anti_template_rules"],
            "properties": {
              "focal_point": {"type": "string", "minLength": 1},
              "reading_path": {"type": "string", "minLength": 1},
              "zones": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {"type": "object", "required": ["name", "purpose"], "properties": {"name": {"type": "string"}, "purpose": {"type": "string"}, "position": {"type": "string"}, "content_capacity": {"type": "string"}}}
                  ]
                }
              },
              "anti_template_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "keyword_emphasis": {
            "type": "object",
            "required": ["rules", "items"],
            "properties": {
              "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["text", "color", "scope"],
                  "properties": {
                    "text": {"type": "string", "minLength": 1},
                    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
                    "scope": {"type": "string", "minLength": 1},
                    "treatment": {"type": "string"}
                  }
                }
              }
            }
          },
          "visual_assertions": {
            "type": "object",
            "properties": {
              "ocr_lang": {"type": "string", "minLength": 1},
              "readback_scope": {"enum": ["declared", "all-render-copy", "title-and-key-anchors"]},
              "must_contain_text": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "forbidden_text": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "min_ink_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "keyword_emphasis": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "color"],
                  "properties": {
                    "text": {"type": "string", "minLength": 1},
                    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
                    "min_pixels": {"type": "integer", "minimum": 1},
                    "tolerance": {"type": "integer", "minimum": 0, "maximum": 255},
                    "region": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
                  }
                }
              }
            }
          },
          "diagram_annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "purpose", "scope", "approved_by"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "scope": {"type": "string", "minLength": 1},
                "approved_by": {"type": "string", "minLength": 1},
                "source_ref": {"type": "string"}
              }
            }
          },
          "reference_treatment": {
            "type": "object",
            "required": ["mode", "source_role", "preserve", "exclude"],
            "properties": {
              "mode": {"enum": ["none", "layout-only", "layout-and-style"]},
              "source_role": {"type": "string", "minLength": 1},
              "preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "exclude": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "production_prompt": {"type": "string"},
          "copy_contract": {
            "type": "object",
            "required": ["render_authority", "render_copy", "exact_once"],
            "properties": {
              "render_authority": {"const": "render_copy"},
              "render_copy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "exact_once": {"const": true},
              "max_total_chars": {"type": "integer", "minimum": 1}
            }
          },
          "representation_policy": {
            "type": "object",
            "required": ["one_primary_encoding", "avoid_duplicate_summary", "secondary_elements", "prohibited_patterns"],
            "properties": {
              "one_primary_encoding": {"const": true},
              "avoid_duplicate_summary": {"const": true},
              "secondary_elements": {"type": "string", "minLength": 1},
              "prohibited_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "formal_text": {"type": "array"},
          "content_model": {"type": "object"},
          "visual_assets": {"type": "object"},
          "reference_images": {"type": "array", "items": {"type": ["string", "object"]}},
          "prompt_file": {"type": "string"}
        }
      }
    }
  }
}
