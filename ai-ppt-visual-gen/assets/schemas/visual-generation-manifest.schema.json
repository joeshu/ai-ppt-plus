{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "project_id", "plan_sha256", "generator_skill", "tool_resolution", "backend_policy", "source_retention", "no_code_overlay", "slides"],
  "properties": {
    "schema": {"const": "ai-ppt-plus/visual-generation-manifest/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "generator_skill": {"type": "string", "minLength": 1},
    "tool_resolution": {"type": "string", "minLength": 1},
    "backend_policy": {"type": "string", "minLength": 1},
    "source_retention": {"type": "string", "minLength": 1},
    "no_code_overlay": {"type": "boolean"},
    "generation_session_id": {"type": "string", "minLength": 1},
    "continuity_policy": {"type": "string", "minLength": 1},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_no", "prompt_file", "generated_source", "copied_to", "generated_source_sha256", "copied_to_sha256", "backend", "model_or_tool", "canvas"],
        "properties": {
          "slide_no": {"type": "integer", "minimum": 1},
          "prompt_file": {"type": "string", "minLength": 1},
          "prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "generated_source": {"type": "string", "minLength": 1},
          "copied_to": {"type": "string", "minLength": 1},
          "generated_source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "copied_to_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "backend": {"type": "string", "minLength": 1},
          "model_or_tool": {"type": "string", "minLength": 1},
          "generation_session_id": {"type": "string", "minLength": 1},
          "context_continuity_status": {"enum": ["preserved", "shared-anchor", "degraded", "unknown"]},
          "canvas": {
            "type": "object",
            "required": ["ratio"],
            "properties": {
              "width_px": {"type": "integer", "minimum": 1},
              "height_px": {"type": "integer", "minimum": 1},
              "ratio": {"enum": ["16:9", "3:2"]}
            }
          }
        }
      }
    },
    "deck_strip": {
      "type": "object",
      "required": ["path", "source_slides", "sha256", "generated_by", "review_status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "source_slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slide_no", "image", "sha256"],
            "properties": {
              "slide_no": {"type": "integer", "minimum": 1},
              "image": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          }
        },
        "columns": {"type": "integer", "minimum": 1},
        "thumbnail_width": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "generated_by": {"type": "string", "minLength": 1},
        "review_status": {"type": "string", "minLength": 1}
      }
    }
  }
}
