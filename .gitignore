__pycache__/
*.py[cod]
.pipeline-cache/
.pytest_cache/

# Generated/evaluation PowerPoint artifacts must be rebuilt, not committed.
evals/**/*.pptx
ai-ppt-editable/evals/**/*.pptx

# Ephemeral render/build output directories.
**/output/
**/outputs/
**/rendered/
**/mutation-render/

# Runtime-managed fonts: policy stays in Git; binary caches do not.
.runtime/
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/*.ttc
ai-ppt-editable/assets/fonts/*.ttf
ai-ppt-editable/assets/fonts/*.otf
ai-ppt-editable/assets/fonts/*.ttc
